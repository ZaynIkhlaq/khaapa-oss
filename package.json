{
  "name": "khaapa",
  "version": "0.1.0",
  "description": "Open-source POS and back office for a student-run shop, on Cloudflare Workers, D1 and R2, with an MCP server for AI agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply khaapa --local",
    "db:migrate": "wrangler d1 migrations apply khaapa --remote",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  }
}
